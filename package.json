{
  "name": "browser-danfe-gen",
  "version": "0.1.0",
  "description": "Generate NF-e DANFE as printable HTML, entirely in the browser.",
  "keywords": ["danfe", "nfe", "nf-e", "nota-fiscal", "sefaz", "brazil", "browser", "html", "print"],
  "author": "Daniel Higa",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/higajooj/browser_danfe_gen.git"
  },
  "homepage": "https://github.com/higajooj/browser_danfe_gen",
  "bugs": "https://github.com/higajooj/browser_danfe_gen/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
